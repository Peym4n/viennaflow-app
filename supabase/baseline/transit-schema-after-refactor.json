  "functions": [
    {
      "name": "get_nearby_steige",
      "definition": "CREATE OR REPLACE FUNCTION public.get_nearby_steige(lat double precision, lon double precision, radius integer DEFAULT 1000)\n RETURNS TABLE(steig_id bigint, fk_linien_id bigint, linien_bezeichnung text, fk_haltestellen_id bigint, haltestellen_name text, haltestellen_diva integer, richtung text, rbl_nummer bigint, location text)\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$BEGIN\r\n    RETURN QUERY\r\n    SELECT\r\n        s.steig_id,\r\n        s.fk_linien_id,\r\n        l.bezeichnung::TEXT AS linien_bezeichnung,\r\n        s.fk_haltestellen_id,\r\n        h.name::TEXT AS haltestellen_name,\r\n        h.diva AS haltestellen_diva,\r\n        s.richtung::TEXT AS richtung,\r\n        s.rbl_nummer::BIGINT AS rbl_nummer,\r\n        ST_AsGeoJSON(s.location)::TEXT AS location\r\n    FROM\r\n        steige s\r\n        JOIN linien l ON s.fk_linien_id = l.linien_id\r\n        JOIN haltestellen h ON s.fk_haltestellen_id = h.haltestellen_id\r\n    WHERE\r\n        ST_DWithin(\r\n            s.location::geography,\r\n            ST_SetSRID(ST_MakePoint(lon, lat), 4326)::geography,\r\n            radius\r\n        );\r\nEND;$function$\n"
    }
  ],
