{
  "name": "viennaflow-app",
  "version": "0.0.0",
  "scripts": {
    "prepare": "husky",
    "ng": "ng",
    "dev:frontend": "npm run generate-env && ng serve --no-hmr",
    "dev:backend": "tsx watch server/dev.ts",
    "dev:delay": "wait-on http-get://localhost:3000/health && npm run dev:frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:delay\"",
    "generate-env": "node scripts/generate-env.js",
    "generate:transit": "tsx scripts/generate-transit-catalog.ts",
    "inspect:database": "tsx scripts/inspect-transit-database.ts",
    "build": "npm run generate-env && ng build",
    "build:staging": "cross-env VIENNAFLOW_ENV=staging npm run build",
    "build:production": "cross-env VIENNAFLOW_ENV=production npm run build",
    "preview": "npm run build && tsx server/dev.ts --preview",
    "preview:serve": "tsx server/dev.ts --preview",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:frontend && npm run test:backend",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "dev:backend:vercel": "vercel dev",
    "test:frontend": "vitest run",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "test:database": "tsx scripts/check-transit-database.ts",
    "typecheck:backend": "tsc --project api/tsconfig.json --noEmit && tsc --project tsconfig.server.json --noEmit",
    "typecheck:tests": "tsc --project tsconfig.spec.json --noEmit",
    "check": "npm test && npm run typecheck:backend && npm run typecheck:tests && npm run build"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "api"
  ],
  "overrides": {
    "vite": "$vite"
  },
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/service-worker": "22.2.3",
    "@dotenvx/dotenvx": "^1.44.1",
    "@supabase/supabase-js": "^2.50.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "wkx": "^0.5.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
