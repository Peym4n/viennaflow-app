{
  "version": 2,
  "cleanUrls": true,
  "schedules": {
    "supabase-keepalive": {
      "path": "/api/cron/supabase-keepalive",
      "schedule": "0 5 * * *",
      "requestMethod": "GET"
    }
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/viennaflow-app/browser",
        "buildCommand": "npm run build"
      }
    },
    {
      "src": "api/routes/monitor.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "api/routes/walking-matrix.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 15
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path((?!.+\\.[^/]+$)[^?]+)",
      "destination": "/api/:path.ts"
    },
    {
      "source": "/((?!api(?:/|$)|_next(?:/|$)|assets(?:/|$))[^.]*)",
      "destination": "/index"
    }
  ]
}
