{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "..",
    "paths": {
      "@shared-types/*": ["../types/*"]
    },
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../types/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
